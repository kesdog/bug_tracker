# Copy to .env. Never commit the populated file.

# Container/local process settings
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
# Loopback prevents bypassing a same-host TLS reverse proxy. See DEPLOYMENT.md
# before changing this to 0.0.0.0.
BIND_ADDRESS=127.0.0.1
HOST_PORT=8080
AllowedHosts=localhost;127.0.0.1
Frontend__Origin=http://localhost:8080

# Public deployment: set the exact TLS proxy source IP and external HTTPS origin.
ForwardedHeaders__Enabled=false
ForwardedHeaders__ForwardLimit=1
ForwardedHeaders__KnownProxies__0=127.0.0.1

# Persistent runtime paths (the Compose volume is mounted at /data)
Database__Path=/data/bug_tracker.db
Audit__LogDirectory=/data/audit
Readiness__MinimumFreeBytes=104857600
TicketDataStorage__MaxBytes=5000000000
AuthenticatedAbuse__StorageSafetyReserveBytes=268435456
AuthenticatedAbuse__Enabled=true
AuthenticatedAbuse__MaxProjects=25
AuthenticatedAbuse__MaxTickets=300
AuthenticatedAbuse__MaxComments=600
AuthenticatedAbuse__MaxAttachments=100
AuthenticatedAbuse__MaxEvidenceBytes=268435456
AuthenticatedAbuse__GeneralPermitLimit=180
AuthenticatedAbuse__GeneralWindowMinutes=1
AuthenticatedAbuse__CreatePermitLimit=10
AuthenticatedAbuse__CreateWindowMinutes=10
AuthenticatedAbuse__WritePermitLimit=60
AuthenticatedAbuse__WriteWindowMinutes=10
AuthenticatedAbuse__UploadPermitLimit=10
AuthenticatedAbuse__UploadWindowMinutes=10
AuthenticatedAbuse__ExportPermitLimit=10
AuthenticatedAbuse__ExportWindowMinutes=10
AuthenticatedAbuse__WebSocketPermitLimit=10
AuthenticatedAbuse__WebSocketWindowMinutes=5

# Generate at least 32 random bytes; for example: openssl rand -base64 48
Auth__TokenSecret=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Image/build settings. The production image always uses same-origin /api.
BUG_TRACKER_IMAGE=bug-tracker:local
VITE_SESSION_INACTIVITY_MINUTES=45

# Optional only when running the Vite development server against another API origin.
VITE_API_PROXY_TARGET=http://127.0.0.1:5040

# Public demo is opt-in. Enable this only for isolated disposable infrastructure.
# ASPNETCORE_ENVIRONMENT=Demo
# Demo__PublicEnabled=true
# Demo-only daily reset. The environment allowlist prevents accidental production use.
DemoReset__Enabled=false
DemoReset__HourUtc=4
DemoReset__AllowedEnvironments__0=Demo
# Fail a reset rather than waiting indefinitely for in-flight work to drain.
DemoReset__DrainTimeoutSeconds=30

# Bound WebSocket shutdown work and per-agent resource consumption.
AgentWebSocket__CloseTimeoutSeconds=5
AgentWebSocket__MaxConnections=100
AgentWebSocket__MaxConnectionsPerUser=5
