{
  "Database": {
    "Path": "../../bug_tracker.db"
  },
  "Auth": {
    "TokenSecret": "replace-this-with-a-long-random-secret-for-non-dev-env"
  },
  "Readiness": {
    "MinimumFreeBytes": 104857600
  },
  "TicketDataStorage": {
    "MaxBytes": 5000000000
  },
  "Demo": {
    "PublicEnabled": false
  },
  "AuthenticatedAbuse": {
    "Enabled": true,
    "StorageSafetyReserveBytes": 268435456,
    "MaxProjects": 25,
    "MaxTickets": 300,
    "MaxComments": 600,
    "MaxAttachments": 100,
    "MaxEvidenceBytes": 268435456,
    "GeneralPermitLimit": 180,
    "GeneralWindowMinutes": 1,
    "CreatePermitLimit": 10,
    "CreateWindowMinutes": 10,
    "WritePermitLimit": 60,
    "WriteWindowMinutes": 10,
    "UploadPermitLimit": 10,
    "UploadWindowMinutes": 10,
    "ExportPermitLimit": 10,
    "ExportWindowMinutes": 10,
    "WebSocketPermitLimit": 10,
    "WebSocketWindowMinutes": 5
  },
  "DemoReset": {
    "Enabled": false,
    "HourUtc": 0,
    "AllowedEnvironments": [],
    "DrainTimeoutSeconds": 30
  },
  "AgentWebSocket": {
    "MaxConnections": 500,
    "MaxConnectionsPerUser": 5,
    "CloseTimeoutSeconds": 5
  },
  "RateLimits": {
    "PublicEndpoints": {
      "HumanLogin": { "IpPermitLimit": 60, "IpWindowMinutes": 5, "IdentityPermitLimit": 20, "IdentityWindowMinutes": 15 },
      "AgentLogin": { "IpPermitLimit": 60, "IpWindowMinutes": 5, "IdentityPermitLimit": 20, "IdentityWindowMinutes": 15 },
      "PasswordSetup": { "IpPermitLimit": 20, "IpWindowMinutes": 15, "IdentityPermitLimit": 5, "IdentityWindowMinutes": 60 },
      "AccessRequest": { "IpPermitLimit": 20, "IpWindowMinutes": 60, "IdentityPermitLimit": 8, "IdentityWindowMinutes": 1440 }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
